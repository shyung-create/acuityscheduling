# Copy to .env and fill in. Never commit the real .env file.
# For the daemon/systemd deployment, source this file or set these as real
# environment variables. For GitHub Actions, set the same names as repo secrets.

# --- Telegram (preferred) ---
# 1. Message @BotFather on Telegram, send /newbot, follow the prompts -> you get a token.
# 2. Send any message to your new bot from the account you want alerts on.
# 3. Visit https://api.telegram.org/bot<TOKEN>/getUpdates and read "chat":{"id": ...} from the JSON.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Email (SMTP, e.g. Gmail with an App Password) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_TO=

# --- Dashboard auth (dashboard.py only) ---
# REQUIRED if you run dashboard.py with --host anything other than 127.0.0.1/
# localhost (e.g. deploying to Fly.io or any other public host) -- it will
# refuse to start without this set. Not needed for purely local use.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=

# --- Appointment alarm (main.py) ---
# Owner-side polling monitor for your own Acuity bookings (new/cancelled/
# rescheduled/reminders), as opposed to the public-availability watcher
# above. Reuses TELEGRAM_BOT_TOKEN/TELEGRAM_CHAT_ID from above.
#
# ACUITY_USER_ID and ACUITY_API_KEY come from Acuity: Business Settings ->
# Integrations -> API. Available on any paid plan (this uses the polling
# /appointments endpoint, not webhooks -- those require Premium/Powerhouse).
ACUITY_USER_ID=
ACUITY_API_KEY=

# How many days ahead to fetch appointments for, each cycle.
POLL_WINDOW_DAYS=7

# Comma-separated minutes-before-appointment to send a reminder. Each value
# fires once per appointment. Default: 24h and 1h before.
REMINDER_THRESHOLDS_MINUTES=1440,60

# Send exactly one "monitor looks unhealthy" Telegram message after this many
# consecutive failed poll cycles (not one warning per failed cycle).
APPOINTMENT_FAILURE_ALERT_THRESHOLD=3

# Where the SQLite dedup/state DB lives.
APPOINTMENT_STATE_DB_PATH=state.db

# Set to any non-empty value to log alerts instead of sending them.
APPOINTMENT_DRY_RUN=

# --- Dead-man's-switch (heartbeat_check.py, run by heartbeat-check.timer) ---
# main.py writes a timestamp here after every poll cycle that completes
# without crashing. heartbeat_check.py -- a separate, standalone script --
# alerts if this file is missing or older than HEARTBEAT_STALE_MINUTES.
# Shared by both main.py and heartbeat_check.py, so set it once here rather
# than relying on their (different) built-in defaults matching by accident.
HEARTBEAT_FILE_PATH=/opt/acuity-alarm/heartbeat.txt
HEARTBEAT_STALE_MINUTES=20
