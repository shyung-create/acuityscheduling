# Copy to .env and fill in. Never commit the real .env file.
# For the daemon/systemd deployment, source this file or set these as real
# environment variables. For GitHub Actions, set the same names as repo secrets.

# --- Telegram (preferred) ---
# 1. Message @BotFather on Telegram, send /newbot, follow the prompts -> you get a token.
# 2. Send any message to your new bot from the account you want alerts on.
# 3. Visit https://api.telegram.org/bot<TOKEN>/getUpdates and read "chat":{"id": ...} from the JSON.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Email (SMTP, e.g. Gmail with an App Password) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_TO=

# --- Dashboard auth (dashboard.py only) ---
# One of DASHBOARD_PASSWORD or DASHBOARD_TRUST_NETWORK_LAYER is REQUIRED if
# you run dashboard.py with --host anything other than 127.0.0.1/localhost
# -- it refuses to start without one of them set. Not needed for purely
# local (loopback) use.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=

# Set to any non-empty value INSTEAD of DASHBOARD_PASSWORD if access is
# already fully gated by the network layer -- e.g. the dashboard is only
# reachable over Tailscale, not the public internet. Skips the HTTP Basic
# Auth prompt entirely. Do not set this if the port is open to
# 0.0.0.0/0 (see infra/README.md's "Reaching the dashboard" -- Option C
# still needs a real password).
DASHBOARD_TRUST_NETWORK_LAYER=

# --- Dead-man's-switch (heartbeat_check.py, run by heartbeat-check.timer) ---
# monitor.py/dashboard.py write {"last_poll": ..., "next_expected_by": ...}
# here after every poll cycle that completes without crashing --
# next_expected_by already accounts for whatever adaptive-polling phase is
# active, so the standalone heartbeat_check.py doesn't need a separate
# flat staleness threshold, just this shared path.
HEARTBEAT_FILE_PATH=/opt/acuity-alarm/heartbeat.txt
