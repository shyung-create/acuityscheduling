[Unit]
Description=Acuity haircut availability monitor -- web dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Runs the dashboard AND the polling loop in one process -- do not also run
# haircut-alarm.service (monitor.py daemon) at the same time, they'd poll
# independently.
#
# Bound to 0.0.0.0 -- reachable from the internet on --port below, gated by
# DASHBOARD_PASSWORD (application-layer only, no TLS -- see
# infra/README.md). This requires infra/'s expose_dashboard_publicly = true
# and DASHBOARD_PASSWORD set in .env; dashboard.py refuses to start
# otherwise. If you'd rather not expose it, change --host back to
# 127.0.0.1 and use an SSH tunnel instead (no infra change needed for that).
User=acuityalarm
Group=acuityalarm
WorkingDirectory=/opt/acuity-alarm
EnvironmentFile=/opt/acuity-alarm/.env
ExecStart=/opt/acuity-alarm/venv/bin/python dashboard.py --config config.yaml --host 0.0.0.0 --port 5000
Restart=on-failure
RestartSec=30

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/acuity-alarm
UMask=0077

[Install]
WantedBy=multi-user.target
