[Unit]
Description=Acuity haircut availability monitor -- web dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Runs the dashboard AND the polling loop in one process -- do not also run
# haircut-alarm.service (monitor.py daemon) at the same time, they'd poll
# independently. Bound to 127.0.0.1 only -- reach it via an SSH tunnel
# (see RUNBOOK.md / the repo's deploy notes), not a publicly open port.
User=acuityalarm
Group=acuityalarm
WorkingDirectory=/opt/acuity-alarm
EnvironmentFile=/opt/acuity-alarm/.env
ExecStart=/opt/acuity-alarm/venv/bin/python dashboard.py --config config.yaml --host 127.0.0.1 --port 5000
Restart=on-failure
RestartSec=30

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/acuity-alarm
UMask=0077

[Install]
WantedBy=multi-user.target
