[Unit]
Description=Acuity haircut availability monitor -- web dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Runs the dashboard AND the polling loop in one process -- do not also run
# haircut-alarm.service (monitor.py daemon) at the same time, they'd poll
# independently.
#
# Bound to 0.0.0.0 so it's reachable via whichever access path you've set
# up -- SSH tunnel, Tailscale, or the public internet -- see infra/README.md
# ("Reaching the dashboard") for all three and their trade-offs. Which
# interfaces can actually deliver a packet here is controlled by the OCI
# security list + this box's iptables rules, not by this bind address.
# DASHBOARD_PASSWORD in .env is required for any of them (dashboard.py
# refuses to start without it once --host isn't loopback) and stays a cheap
# extra layer even under Tailscale, where tailnet membership is the real
# gate.
User=acuityalarm
Group=acuityalarm
WorkingDirectory=/opt/acuity-alarm
EnvironmentFile=/opt/acuity-alarm/.env
ExecStart=/opt/acuity-alarm/venv/bin/python dashboard.py --config config.yaml --host 0.0.0.0 --port 5000
Restart=on-failure
RestartSec=30

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/acuity-alarm
UMask=0077

[Install]
WantedBy=multi-user.target
