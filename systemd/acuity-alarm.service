[Unit]
Description=Acuity appointment alarm (single poll cycle)
Wants=network-online.target
After=network-online.target

[Service]
# Runs main.py once and exits; acuity-alarm.timer decides how often. Do not
# add [Install]/enable this unit directly -- enable the .timer instead.
Type=oneshot
User=acuityalarm
Group=acuityalarm
WorkingDirectory=/opt/acuity-alarm
EnvironmentFile=/opt/acuity-alarm/.env
ExecStart=/opt/acuity-alarm/venv/bin/python /opt/acuity-alarm/main.py
Restart=on-failure
RestartSec=30

# Hardening -- see SETUP.md for the matching `acuityalarm` system user.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/acuity-alarm
UMask=0077
