[Unit]
Description=Run the appointment alarm's dead-man's-switch check on a fixed interval

[Timer]
# Single source of truth for this check's cadence -- change it here only.
# 30 min against a 20 min staleness threshold (HEARTBEAT_STALE_MINUTES in
# .env) gives one grace check before an outage is reported as stuck.
OnBootSec=10min
OnUnitActiveSec=30min
AccuracySec=1min
Unit=heartbeat-check.service

[Install]
WantedBy=timers.target
