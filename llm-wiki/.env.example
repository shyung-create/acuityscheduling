# Copy to .env and fill in. Never commit the real .env file.
# For the systemd deployment, EnvironmentFile= points at this file directly.

# --- DeepSeek API ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# "Deep" model: synthesis, judgment calls, contradiction-checking.
# Used by ingest.py (page create/update decisions) and query.py (answer synthesis).
DEEPSEEK_DEEP_MODEL=deepseek-v4-pro

# "Quick" model: cheap classification/dedup/frontmatter work.
# Used by ingest.py (candidate extraction) and lint.py (staleness/dup checks).
DEEPSEEK_QUICK_MODEL=deepseek-v4-flash

# --- Cost estimation (USD per 1M tokens) ---
# Update these to match current DeepSeek pricing; used only to populate
# api_calls.estimated_cost_usd, not sent to the API. If unset, cost is
# logged as NULL rather than guessed.
DEEPSEEK_DEEP_INPUT_COST_PER_1M=
DEEPSEEK_DEEP_OUTPUT_COST_PER_1M=
DEEPSEEK_QUICK_INPUT_COST_PER_1M=
DEEPSEEK_QUICK_OUTPUT_COST_PER_1M=
